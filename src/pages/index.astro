---
const target = "/en/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <title>Redirecting…</title>
    <script>
      window.location.replace("/en/");
    </script>
  </head>
  <body>
    <p>
      Redirecting to <a href={target}>{target}</a>...
    </p>
  </body>
</html>
